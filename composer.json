{
    "name": "sloukapetr/moneta-laravel-package",
    "description": "Lightweight Laravel package for Moneta Money Bank VIP REST API integration.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "moneta",
        "banking",
        "aisp",
        "accounts",
        "statements"
    ],
    "homepage": "https://github.com/sloukapetr/moneta-laravel-package",
    "support": {
        "issues": "https://github.com/sloukapetr/moneta-laravel-package/issues",
        "source": "https://github.com/sloukapetr/moneta-laravel-package"
    },
    "require": {
        "php": "^8.2",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SloukaPetr\\Moneta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SloukaPetr\\Moneta\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SloukaPetr\\Moneta\\MonetaServiceProvider"
            ],
            "aliases": {
                "Moneta": "SloukaPetr\\Moneta\\Facades\\Moneta"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
