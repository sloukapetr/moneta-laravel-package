          }
        },
        "security" : [ {
          "OAuth2ClientCredentials" : [ "vip_sandbox" ]
        } ],
        "summary" : "Create new standing order",
        "tags" : [ "Standing Payment Order" ]
      }
    }
  },
  "schemes" : [ "https" ],
  "servers" : [ {
    "url" : "https://api.moneta.cz"
  } ],
