  "host" : "api.moneta.cz:8443",
  "info" : {
    "description" : "+ This API is used to validate VIP (Moneta API) tokens and retrieve their expiration time. If the provided token is not a Moneta API token, the endpoint returns **403** with the message: 'This is not a Moneta API token. This API is intended solely for validating the authenticity of a Moneta API token.'",
    "title" : "REST API implementation of VIP bank API",
    "version" : "1.0.0"
  },
  "openapi" : "3.0.3",
  "paths" : {
    "/api/v1/vip/token/introspect" : {
      "get" : {
        "deprecated" : false,
        "parameters" : [ {
          "description" : "The identification number (IČO) of a legal entity or entrepreneur.",
          "explode" : false,
          "in" : "header",
          "name" : "identification_number",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        }, {
          "description" : "The official name of the business entity associated with the given identification number (IČO).",
          "explode" : false,
          "in" : "header",
          "name" : "business_name",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        }, {
          "description" : "The name of the application to which our APIs are integrated.",
          "explode" : false,
          "in" : "header",
          "name" : "application_name",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "properties" : {
                    "expiration" : {
                      "description" : "token expiration timestamp",
                      "example" : "2026-03-06T11:38:09+01:00",
                      "format" : "date-time",
                      "type" : "string"
                    }
                  },
                  "type" : "object"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
